{
  "name": "proposta",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:ui": "vite --host localhost --strictPort",
    "dev:api": "node --watch backend/src/server.js",
    "build": "vite build",
    "test": "node --test backend/tests/*.test.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "db:seed": "node backend/prisma/seed.js",
    "db:super-admin": "node backend/prisma/create-super-admin.js",
    "start:stack": "npm run db:generate && npm run db:deploy && npm run db:super-admin && npm run dev:all"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "framer-motion": "^12.23.24",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prisma": "^6.19.0",
    "vite": "^8.3.6"
  }
}
